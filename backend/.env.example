# Net Worth Tracker – Backend Environment Variables
# Copy this file to .env and fill in your values.

# Server port (default: 3001)
PORT=3001

# ──────────────────────────────────────────────────────────
# AI-Assisted PDF Parsing (optional)
# When set, the /api/import/pdf endpoints will use an
# OpenAI-compatible LLM to extract structured records from
# PDF statement text, giving much higher accuracy.
#
# Works with:
#   - OpenAI (default):        https://api.openai.com/v1
#   - Azure OpenAI:            https://<resource>.openai.azure.com/openai/deployments/<model>
#   - Ollama (local):          http://localhost:11434/v1
#   - Any OpenAI-compatible API
# ──────────────────────────────────────────────────────────

# AI_API_KEY=sk-...               # or OPENAI_API_KEY=sk-...
# AI_API_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
